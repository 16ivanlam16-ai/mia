# Copy to .env for local builds if you need to try a real ID.
# Leave every value blank for the launch build. Do not invent IDs.

# GA4 measurement ID only, for example G-AB12CD34EF.
# Repository variable for GitHub Actions: PUBLIC_GA_MEASUREMENT_ID
PUBLIC_GA_MEASUREMENT_ID=

# Search Console HTML-tag verification, the content="" value only.
# Repository variable: PUBLIC_GSC_VERIFICATION
PUBLIC_GSC_VERIFICATION=

# Optional https endpoint. The browser sendBeacon's a text/plain JSON body.
# Leave blank on GitHub Pages until a collector exists.
# Repository variable: PUBLIC_CLICK_WEBHOOK_URL
PUBLIC_CLICK_WEBHOOK_URL=

# Production defaults. For a custom domain later:
#   SITE_URL=https://example.com
#   BASE_PATH=/
SITE_URL=https://16ivanlam16-ai.github.io
BASE_PATH=/mia
