---
import type { Messages } from "../i18n";
import { features } from "../lib/features";
import type { Lang } from "../lib/taxonomy";
import { pagePath } from "../lib/urls";

interface Item {
  key: string;
  href: string;
  label: string;
}
interface Props {
  lang: Lang;
  path: string;
  current: string;
  t: Messages;
}
const { lang, path, current, t } = Astro.props;
const items: Item[] = [
  { key: "compare", href: pagePath(lang, "compare"), label: t.nav.compare },
  ...(features.guides ? [{ key: "guides", href: pagePath(lang, "guides"), label: t.nav.guides }] : []),
  ...(features.claims ? [{ key: "claims", href: pagePath(lang, "claims"), label: t.nav.claims }] : []),
  { key: "about", href: pagePath(lang, "about"), label: t.nav.about },
  { key: "contact", href: pagePath(lang, "contact"), label: t.nav.contact },
];
const home = pagePath(lang);
const icon = `${import.meta.env.BASE_URL}favicon.svg`;
const hantHref = pagePath("zh-hant", path);
const hansHref = pagePath("zh-hans", path);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href={home} aria-label={t.a11y.home}>
      <img src={icon} width="28" height="28" alt="" />
      <span>Mia</span>
    </a>
    <nav class="desktop-nav" aria-label={t.nav.primary}>
      {
        items.map((item) => (
          <a href={item.href} aria-current={current === item.key ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="bar-end">
      <nav class="langs" aria-label={t.lang.label}>
        <a
          href={hantHref}
          hreflang="zh-Hant-HK"
          lang="zh-Hant-HK"
          data-lang-switch="zh-hant"
          data-base={hantHref}
          aria-current={lang === "zh-hant" ? "true" : undefined}
          >{t.lang.hant}</a
        >
        <a
          href={hansHref}
          hreflang="zh-Hans"
          lang="zh-Hans"
          data-lang-switch="zh-hans"
          data-base={hansHref}
          aria-current={lang === "zh-hans" ? "true" : undefined}
          >{t.lang.hans}</a
        >
      </nav>
      <details class="mobile-only nav-drawer">
        <summary class="nav-toggle">{t.nav.menu}</summary>
        <nav class="mobile-panel" aria-label={t.nav.primary}>
          {
            items.map((item) => (
              <a href={item.href} aria-current={current === item.key ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
