---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { guides } from "../../../content/guides";
import { messages } from "../../../i18n";
import { isLang, localePaths, type Lang } from "../../../lib/taxonomy";
import { pagePath } from "../../../lib/urls";

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Lang;
if (!isLang(lang)) throw new Error("Unsupported language");
const t = messages[lang];
---

<BaseLayout lang={lang} title={t.guides.title} description={t.seo.guides} path="guides">
  <div class="wrap">
    <header class="page-hero">
      <Breadcrumbs
        label={t.a11y.breadcrumb}
        items={[
          { label: t.nav.home, href: pagePath(lang) },
          { label: t.guides.title },
        ]}
      />
      <p class="eyebrow">{t.guides.eyebrow}</p>
      <h1>{t.guides.title}</h1>
      <p class="lede">{t.guides.lede}</p>
    </header>
    <ul class="guide-grid">
      {
        guides.map((guide) => (
          <li>
            <a class="panel panel-link" href={pagePath(lang, `guides/${guide.slug}`)}>
              <p class="tag">{t.copyBadge}</p>
              <h2>{guide.title[lang]}</h2>
              <p>{guide.description[lang]}</p>
              <span>{t.guides.read}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
