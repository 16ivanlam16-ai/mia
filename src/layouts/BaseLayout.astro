---
import "@fontsource/manrope/latin-400.css";
import "@fontsource/manrope/latin-600.css";
import "@fontsource/manrope/latin-700.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { messages } from "../i18n";
import { gaMeasurementId, gscVerification } from "../lib/analytics";
import { HTML_LANG, HREFLANG, LANGS, OG_LOCALE, type Lang } from "../lib/taxonomy";
import { absoluteUrl, pagePath, sectionOf } from "../lib/urls";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
  pageId?: string;
  canonicalPath?: string;
  noindex?: boolean;
  omitAlternates?: boolean;
  showChrome?: boolean;
  bare?: boolean;
}
const {
  lang,
  title,
  description,
  path = "",
  pageId,
  canonicalPath,
  noindex = false,
  omitAlternates = false,
  showChrome = true,
  bare = false,
} = Astro.props;
const t = messages[lang];
const documentTitle = `${title}｜Mia`;
const site = Astro.site ?? new URL("https://16ivanlam16-ai.github.io");
const canonPath = canonicalPath ?? pagePath(lang, path);
const canonical = absoluteUrl(site, canonPath);
const ogImage = absoluteUrl(site, `${import.meta.env.BASE_URL}og.png`);
const alternates = LANGS.map((code) => ({
  lang: HREFLANG[code],
  href: absoluteUrl(site, pagePath(code, path)),
}));
const xDefault = absoluteUrl(site, pagePath("zh-hant", path));
const current = sectionOf(path);
const id = pageId ?? (path === "" ? "home" : path.split("/")[0] || "home");
---

<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !omitAlternates &&
        alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)
    }
    {!omitAlternates && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mia" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo.ogAlt} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={OG_LOCALE[code]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#243330" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <!--
      Analytics and Search Console stay off until the build has real IDs.
      PUBLIC_GA_MEASUREMENT_ID (GA4, G-XXXXXXXX) and PUBLIC_GSC_VERIFICATION
      are read at build time. This repo does not invent either value.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };
    </script>
    {
      gaMeasurementId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.gtag("js", new Date());
            window.gtag("config", gaMeasurementId, { anonymize_ip: true });
          </script>
        </>
      )
    }
  </head>
  <body>
    {!bare && <a class="skip-link" href="#main">{t.a11y.skip}</a>}
    {!bare && <div class="preview-banner"><p>{t.banner}</p></div>}
    {!bare && showChrome && <Header lang={lang} path={path} current={current} t={t} />}
    <main id="main" tabindex="-1" data-page={id}>
      <slot />
    </main>
    {!bare && showChrome && <Footer lang={lang} t={t} />}
    <script>
      import "../scripts/nav.ts";
    </script>
  </body>
</html>
